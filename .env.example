# Choose one news provider for gold decisions.
# If both broker terminals are installed, set each path to its own terminal64.exe.
# DEMO and LIVE use the same broker terminal path; sign in to the selected account in MT5.
# IC_MARKETS_MT5_PATH=C:\Program Files\IC Markets\MetaTrader 5\terminal64.exe
# EXNESS_MT5_PATH=C:\Program Files\Exness\MetaTrader 5\terminal64.exe
# Local Ollama: install the model with `ollama pull qwen3`.
IC_MARKETS_NEWS_PROVIDER=ollama
IC_MARKETS_OLLAMA_MODEL=qwen3:latest
IC_MARKETS_OLLAMA_URL=http://127.0.0.1:11434

# Exness uses its own news settings. The IC Markets settings above are fallback values.
# EXNESS_NEWS_PROVIDER=ollama
# EXNESS_OLLAMA_MODEL=qwen3:latest
# EXNESS_OLLAMA_URL=http://127.0.0.1:11434

# For OpenAI instead, set IC_MARKETS_NEWS_PROVIDER=openai and add your key.
# OPENAI_API_KEY=
# IC_MARKETS_NEWS_MODEL=gpt-4.1-mini

# Optional Telegram decision notifications.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional legacy Alpaca stock research workflow.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_DATA_FEED=iex
