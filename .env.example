# Copy to .env and fill only the values needed for your chosen workflow.
# Never commit .env or put real credentials in this example.

# Gold news gate: choose ollama (local) or openai (cloud).
XM_NEWS_PROVIDER=ollama
XM_OLLAMA_URL=http://127.0.0.1:11434
XM_OLLAMA_MODEL=qwen2.5:7b-instruct
OPENAI_API_KEY=
XM_NEWS_MODEL=gpt-4.1-mini

# Optional legacy Alpaca research pipeline (read-only market data).
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex
