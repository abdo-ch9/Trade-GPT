# Choose one news provider for gold decisions.
# Local Ollama: install the model with `ollama pull qwen2.5:7b-instruct`.
IC_MARKETS_NEWS_PROVIDER=ollama
IC_MARKETS_OLLAMA_MODEL=qwen2.5:7b-instruct
IC_MARKETS_OLLAMA_URL=http://127.0.0.1:11434

# For OpenAI instead, set IC_MARKETS_NEWS_PROVIDER=openai and add your key.
# OPENAI_API_KEY=
# IC_MARKETS_NEWS_MODEL=gpt-4.1-mini

# Optional Telegram decision notifications.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional legacy Alpaca stock research workflow.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_DATA_FEED=iex
